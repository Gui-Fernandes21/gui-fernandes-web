{
  "name": "gui-fernandes-web",
  "private": true,
  "version": "2.0",
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "deploy": "pnpm build && npx firebase-tools deploy --project gui-fernandes-web",
    "deploy:update": "npx nuxt build && rm -rf .output/server/node_modules .output/server/package-lock.json && npm --prefix .output/server install && FUNCTIONS_DISCOVERY_TIMEOUT=60 npx firebase-tools@latest deploy",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "devDependencies": {
    "@nuxt/devtools": "latest",
    "@nuxt/fonts": "^0.11.1",
    "@nuxtjs/seo": "^3.0.3",
    "firebase-functions": "^7.4.0",
    "nuxt": "^3.16.2",
    "nuxt-aos": "^1.2.5",
    "typescript": "^5.8.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "dependencies": {
    "@nuxt/ui": "3.1.0",
    "@nuxtjs/svg-sprite": "^1.0.2",
    "@splidejs/vue-splide": "^0.6.12",
    "@vee-validate/i18n": "^4.15.0",
    "@vee-validate/rules": "^4.15.0",
    "@vee-validate/valibot": "^4.15.0",
    "axios": "^1.8.4",
    "firebase": "^11.6.0",
    "firebase-tools": "^15.32.1",
    "maska": "^3.1.1",
    "motion-v": "1.0.0-beta.2",
    "normalize.css": "^8.0.1",
    "nuxt-icons": "^3.2.1",
    "tailwindcss": "^4.1.4",
    "valibot": "^1.0.0",
    "vee-validate": "^4.15.0"
  }
}
